{
  "redirects": [
    {
      "source": "/mushaf",
      "destination": "/?tab=okuma",
      "permanent": false
    },
    {
      "source": "/mushaf/:path*",
      "destination": "/?tab=okuma",
      "permanent": false
    },
    {
      "source": "/quran_vocab",
      "destination": "https://kelime.muallimun.net/",
      "permanent": true
    },
    {
      "source": "/quran_vocab/:path*",
      "destination": "https://kelime.muallimun.net/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|data/|fonts/|sfx/|icons/|assets/|manifest\\.webmanifest|sw\\.js|workbox-.*\\.js|registerSW\\.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=(), usb=(), microphone=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://kuran.muallimun.net; img-src 'self' data: blob: https://kuran.muallimun.net; media-src 'self' data: blob: https://kuran.muallimun.net https://everyayah.com https://*.everyayah.com https://archive.org https://*.archive.org https://audio.qurancdn.com https://verses.quran.com; connect-src 'self' https://kuran.muallimun.net https://everyayah.com https://archive.org https://*.archive.org https://fonts.googleapis.com https://fonts.gstatic.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://*.muallimun.net"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(fonts|sfx|icons)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
