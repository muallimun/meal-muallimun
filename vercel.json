{
  "redirects": [
    {
      "source": "/mushaf",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mushaf/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/quran_vocab",
      "destination": "https://kelime.muallimun.net/",
      "permanent": true
    },
    {
      "source": "/quran_vocab/:path*",
      "destination": "https://kelime.muallimun.net/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!data/|fonts/|sfx/|icons/|assets/|manifest\\.webmanifest|sw\\.js|workbox-.*\\.js|registerSW\\.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self)"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(fonts|sfx)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
