{"s":95,"verses":[{"id":95001,"a":1,"c":30,"p":596,"t":"وَالتّ۪ينِ وَالزَّيْتُونِۙ","wc":2},{"id":95002,"a":2,"c":30,"p":596,"t":"وَطُورِ س۪ين۪ينَۙ","wc":2},{"id":95003,"a":3,"c":30,"p":596,"t":"وَهٰذَا الْبَلَدِ الْاَم۪ينِۙ","wc":3},{"id":95004,"a":4,"c":30,"p":596,"t":"لَقَدْ خَلَقْنَا الْاِنْسَانَ ف۪ٓي اَحْسَنِ تَقْو۪يمٍۘ","wc":6},{"id":95005,"a":5,"c":30,"p":596,"t":"ثُمَّ رَدَدْنَاهُ اَسْفَلَ سَافِل۪ينَۙ","wc":4},{"id":95006,"a":6,"c":30,"p":597,"t":"اِلَّا الَّذ۪ينَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَلَهُمْ اَجْرٌ غَيْرُ مَمْنُونٍۜ","wc":9},{"id":95007,"a":7,"c":30,"p":597,"t":"فَمَا يُكَذِّبُكَ بَعْدُ بِالدّ۪ينِۜ","wc":4},{"id":95008,"a":8,"c":30,"p":597,"t":"اَلَيْسَ اللّٰهُ بِاَحْكَمِ الْحَاكِم۪ينَ","wc":4}]}