{"s":85,"verses":[{"id":85001,"a":1,"c":30,"p":589,"t":"وَالسَّمَٓاءِ ذَاتِ الْبُرُوجِۙ","wc":3},{"id":85002,"a":2,"c":30,"p":589,"t":"وَالْيَوْمِ الْمَوْعُودِۙ","wc":2},{"id":85003,"a":3,"c":30,"p":589,"t":"وَشَاهِدٍ وَمَشْهُودٍۜ","wc":2},{"id":85004,"a":4,"c":30,"p":589,"t":"قُتِلَ اَصْحَابُ الْاُخْدُودِۙ","wc":3},{"id":85005,"a":5,"c":30,"p":589,"t":"اَلنَّارِ ذَاتِ الْوَقُودِۙ","wc":3},{"id":85006,"a":6,"c":30,"p":589,"t":"اِذْ هُمْ عَلَيْهَا قُعُودٌۙ","wc":4},{"id":85007,"a":7,"c":30,"p":589,"t":"وَهُمْ عَلٰى مَا يَفْعَلُونَ بِالْمُؤْمِن۪ينَ شُهُودٌۜ","wc":6},{"id":85008,"a":8,"c":30,"p":589,"t":"وَمَا نَقَمُوا مِنْهُمْ اِلَّٓا اَنْ يُؤْمِنُوا بِاللّٰهِ الْعَز۪يزِ الْحَم۪يدِۙ","wc":9},{"id":85009,"a":9,"c":30,"p":589,"t":"اَلَّذ۪ي لَهُ مُلْكُ السَّمٰوَاتِ وَالْاَرْضِۜ وَاللّٰهُ عَلٰى كُلِّ شَيْءٍ شَه۪يدٌۜ","wc":10},{"id":85010,"a":10,"c":30,"p":589,"t":"اِنَّ الَّذ۪ينَ فَتَنُوا الْمُؤْمِن۪ينَ وَالْمُؤْمِنَاتِ ثُمَّ لَمْ يَتُوبُوا فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ الْحَر۪يقِۜ","wc":14},{"id":85011,"a":11,"c":30,"p":589,"t":"اِنَّ الَّذ۪ينَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ جَنَّاتٌ تَجْر۪ي مِنْ تَحْتِهَا الْاَنْهَارُۜ ذٰلِكَ الْفَوْزُ الْكَب۪يرُۜ","wc":14},{"id":85012,"a":12,"c":30,"p":590,"t":"اِنَّ بَطْشَ رَبِّكَ لَشَد۪يدٌۜ","wc":4},{"id":85013,"a":13,"c":30,"p":590,"t":"اِنَّهُ هُوَ يُبْدِئُ وَيُع۪يدُۚ","wc":4},{"id":85014,"a":14,"c":30,"p":590,"t":"وَهُوَ الْغَفُورُ الْوَدُودُۙ","wc":3},{"id":85015,"a":15,"c":30,"p":590,"t":"ذُو الْعَرْشِ الْمَج۪يدُۙ","wc":3},{"id":85016,"a":16,"c":30,"p":590,"t":"فَعَّالٌ لِمَا يُر۪يدُۜ","wc":3},{"id":85017,"a":17,"c":30,"p":590,"t":"هَلْ اَتٰيكَ حَد۪يثُ الْجُنُودِۙ","wc":4},{"id":85018,"a":18,"c":30,"p":590,"t":"فِرْعَوْنَ وَثَمُودَۜ","wc":2},{"id":85019,"a":19,"c":30,"p":590,"t":"بَلِ الَّذ۪ينَ كَفَرُوا ف۪ي تَكْذ۪يبٍۙ","wc":5},{"id":85020,"a":20,"c":30,"p":590,"t":"وَاللّٰهُ مِنْ وَرَٓائِهِمْ مُح۪يطٌۚ","wc":4},{"id":85021,"a":21,"c":30,"p":590,"t":"بَلْ هُوَ قُرْاٰنٌ مَج۪يدٌۙ","wc":4},{"id":85022,"a":22,"c":30,"p":590,"t":"ف۪ي لَوْحٍ مَحْفُوظٍ","wc":3}]}