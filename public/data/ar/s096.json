{"s":96,"verses":[{"id":96001,"a":1,"c":30,"p":597,"t":"اِقْرَأْ بِاسْمِ رَبِّكَ الَّذ۪ي خَلَقَۚ","wc":5},{"id":96002,"a":2,"c":30,"p":597,"t":"خَلَقَ الْاِنْسَانَ مِنْ عَلَقٍۚ","wc":4},{"id":96003,"a":3,"c":30,"p":597,"t":"اِقْرَأْ وَرَبُّكَ الْاَكْرَمُۙ","wc":3},{"id":96004,"a":4,"c":30,"p":597,"t":"اَلَّذ۪ي عَلَّمَ بِالْقَلَمِۙ","wc":3},{"id":96005,"a":5,"c":30,"p":597,"t":"عَلَّمَ الْاِنْسَانَ مَا لَمْ يَعْلَمْۜ","wc":5},{"id":96006,"a":6,"c":30,"p":597,"t":"كَلَّٓا اِنَّ الْاِنْسَانَ لَيَطْغٰىۙ","wc":4},{"id":96007,"a":7,"c":30,"p":597,"t":"اَنْ رَاٰهُ اسْتَغْنٰىۜ","wc":3},{"id":96008,"a":8,"c":30,"p":597,"t":"اِنَّ اِلٰى رَبِّكَ الرُّجْعٰىۜ","wc":4},{"id":96009,"a":9,"c":30,"p":597,"t":"اَرَاَيْتَ الَّذ۪ي يَنْهٰىۙ","wc":3},{"id":96010,"a":10,"c":30,"p":597,"t":"عَبْدًا اِذَا صَلّٰىۜ","wc":3},{"id":96011,"a":11,"c":30,"p":597,"t":"اَرَاَيْتَ اِنْ كَانَ عَلَى الْهُدٰىۙ","wc":5},{"id":96012,"a":12,"c":30,"p":597,"t":"اَوْ اَمَرَ بِالتَّقْوٰىۜ","wc":3},{"id":96013,"a":13,"c":30,"p":597,"t":"اَرَاَيْتَ اِنْ كَذَّبَ وَتَوَلّٰىۜ","wc":4},{"id":96014,"a":14,"c":30,"p":597,"t":"اَلَمْ يَعْلَمْ بِاَنَّ اللّٰهَ يَرٰىۜ","wc":5},{"id":96015,"a":15,"c":30,"p":597,"t":"كَلَّا لَئِنْ لَمْ يَنْتَهِ۬ لَنَسْفَعًا بِالنَّاصِيَةِۙ","wc":6},{"id":96016,"a":16,"c":30,"p":597,"t":"نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍۚ","wc":3},{"id":96017,"a":17,"c":30,"p":597,"t":"فَلْيَدْعُ نَادِيَهُۙ","wc":2},{"id":96018,"a":18,"c":30,"p":597,"t":"سَنَدْعُ الزَّبَانِيَةَۙ","wc":2},{"id":96019,"a":19,"c":30,"p":597,"t":"كَلَّاۜ لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبْ ۩","wc":5}]}