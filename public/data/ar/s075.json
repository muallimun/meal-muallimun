{"s":75,"verses":[{"id":75001,"a":1,"c":29,"p":576,"t":"لَٓا اُقْسِمُ بِيَوْمِ الْقِيٰمَةِۙ","wc":4},{"id":75002,"a":2,"c":29,"p":576,"t":"وَلَٓا اُقْسِمُ بِالنَّفْسِ اللَّوَّامَةِ","wc":4},{"id":75003,"a":3,"c":29,"p":576,"t":"اَيَحْسَبُ الْاِنْسَانُ اَلَّنْ نَجْمَعَ عِظَامَهُۜ","wc":5},{"id":75004,"a":4,"c":29,"p":576,"t":"بَلٰى قَادِر۪ينَ عَلٰٓى اَنْ نُسَوِّيَ بَنَانَهُ","wc":6},{"id":75005,"a":5,"c":29,"p":576,"t":"بَلْ يُر۪يدُ الْاِنْسَانُ لِيَفْجُرَ اَمَامَهُۚ","wc":5},{"id":75006,"a":6,"c":29,"p":576,"t":"يَسْـَٔلُ اَيَّانَ يَوْمُ الْقِيٰمَةِۜ","wc":4},{"id":75007,"a":7,"c":29,"p":576,"t":"فَاِذَا بَرِقَ الْبَصَرُۙ","wc":3},{"id":75008,"a":8,"c":29,"p":576,"t":"وَخَسَفَ الْقَمَرُۙ","wc":2},{"id":75009,"a":9,"c":29,"p":576,"t":"وَجُمِعَ الشَّمْسُ وَالْقَمَرُۙ","wc":3},{"id":75010,"a":10,"c":29,"p":576,"t":"يَقُولُ الْاِنْسَانُ يَوْمَئِذٍ اَيْنَ الْمَفَرُّۚ","wc":5},{"id":75011,"a":11,"c":29,"p":576,"t":"كَلَّا لَا وَزَرَۚ","wc":3},{"id":75012,"a":12,"c":29,"p":576,"t":"اِلٰى رَبِّكَ يَوْمَئِذٍۨ الْمُسْتَقَرُّۜ","wc":4},{"id":75013,"a":13,"c":29,"p":576,"t":"يُنَبَّؤُا الْاِنْسَانُ يَوْمَئِذٍ بِمَا قَدَّمَ وَاَخَّرَۜ","wc":6},{"id":75014,"a":14,"c":29,"p":576,"t":"بَلِ الْاِنْسَانُ عَلٰى نَفْسِه۪ بَص۪يرَةٌۙ","wc":5},{"id":75015,"a":15,"c":29,"p":576,"t":"وَلَوْ اَلْقٰى مَعَاذ۪يرَهُۜ","wc":3},{"id":75016,"a":16,"c":29,"p":576,"t":"لَا تُحَرِّكْ بِه۪ لِسَانَكَ لِتَعْجَلَ بِه۪ۜ","wc":6},{"id":75017,"a":17,"c":29,"p":576,"t":"اِنَّ عَلَيْنَا جَمْعَهُ وَقُرْاٰنَهُۚ","wc":4},{"id":75018,"a":18,"c":29,"p":576,"t":"فَاِذَا قَرَأْنَاهُ فَاتَّبِعْ قُرْاٰنَهُۚ","wc":4},{"id":75019,"a":19,"c":29,"p":576,"t":"ثُمَّ اِنَّ عَلَيْنَا بَيَانَهُۜ","wc":4},{"id":75020,"a":20,"c":29,"p":577,"t":"كَلَّا بَلْ تُحِبُّونَ الْعَاجِلَةَۙ","wc":4},{"id":75021,"a":21,"c":29,"p":577,"t":"وَتَذَرُونَ الْاٰخِرَةَۜ","wc":2},{"id":75022,"a":22,"c":29,"p":577,"t":"وُجُوهٌ يَوْمَئِذٍ نَاضِرَةٌۙ","wc":3},{"id":75023,"a":23,"c":29,"p":577,"t":"اِلٰى رَبِّهَا نَاظِرَةٌۚ","wc":3},{"id":75024,"a":24,