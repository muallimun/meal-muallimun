{"s":99,"verses":[{"id":99001,"a":1,"c":30,"p":599,"t":"اِذَا زُلْزِلَتِ الْاَرْضُ زِلْزَالَهَاۙ","wc":4},{"id":99002,"a":2,"c":30,"p":599,"t":"وَاَخْرَجَتِ الْاَرْضُ اَثْقَالَهَاۙ","wc":3},{"id":99003,"a":3,"c":30,"p":599,"t":"وَقَالَ الْاِنْسَانُ مَا لَهَاۚ","wc":4},{"id":99004,"a":4,"c":30,"p":599,"t":"يَوْمَئِذٍ تُحَدِّثُ اَخْبَارَهَاۙ","wc":3},{"id":99005,"a":5,"c":30,"p":599,"t":"بِاَنَّ رَبَّكَ اَوْحٰى لَهَاۜ","wc":4},{"id":99006,"a":6,"c":30,"p":599,"t":"يَوْمَئِذٍ يَصْدُرُ النَّاسُ اَشْتَاتًاۙ لِيُرَوْا اَعْمَالَهُمْۜ","wc":6},{"id":99007,"a":7,"c":30,"p":599,"t":"فَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُۜ","wc":6},{"id":99008,"a":8,"c":30,"p":599,"t":"وَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُ","wc":6}]}