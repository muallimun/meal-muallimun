{"s":69,"verses":[{"id":69001,"a":1,"c":29,"p":565,"t":"اَلْحَٓاقَّةُۙ","wc":1},{"id":69002,"a":2,"c":29,"p":565,"t":"مَا الْحَٓاقَّةُۚ","wc":2},{"id":69003,"a":3,"c":29,"p":565,"t":"وَمَٓا اَدْرٰيكَ مَا الْحَٓاقَّةُۜ","wc":4},{"id":69004,"a":4,"c":29,"p":565,"t":"كَذَّبَتْ ثَمُودُ وَعَادٌ بِالْقَارِعَةِ","wc":4},{"id":69005,"a":5,"c":29,"p":565,"t":"فَاَمَّا ثَمُودُ فَاُهْلِكُوا بِالطَّاغِيَةِ","wc":4},{"id":69006,"a":6,"c":29,"p":565,"t":"وَاَمَّا عَادٌ فَاُهْلِكُوا بِر۪يحٍ صَرْصَرٍ عَاتِيَةٍۙ","wc":6},{"id":69007,"a":7,"c":29,"p":565,"t":"سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍ وَثَمَانِيَةَ اَيَّامٍۙ حُسُومًا فَتَرَى الْقَوْمَ ف۪يهَا صَرْعٰىۙ كَاَنَّهُمْ اَعْجَازُ نَخْلٍ خَاوِيَةٍۚ","wc":15},{"id":69008,"a":8,"c":29,"p":565,"t":"فَهَلْ تَرٰى لَهُمْ مِنْ بَاقِيَةٍ","wc":5},{"id":69009,"a":9,"c":29,"p":566,"t":"وَجَٓاءَ فِرْعَوْنُ وَمَنْ قَبْلَهُ وَالْمُؤْتَفِكَاتُ بِالْخَاطِئَةِۚ","wc":6},{"id":69010,"a":10,"c":29,"p":566,"t":"فَعَصَوْا رَسُولَ رَبِّهِمْ فَاَخَذَهُمْ اَخْذَةً رَابِيَةً","wc":6},{"id":69011,"a":11,"c":29,"p":566,"t":"اِنَّا لَمَّا طَغَا الْمَٓاءُ حَمَلْنَاكُمْ فِي الْجَارِيَةِۙ","wc":7},{"id":69012,"a":12,"c":29,"p":566,"t":"لِنَجْعَلَهَا لَكُمْ تَذْكِرَةً وَتَعِيَهَٓا اُذُنٌ وَاعِيَةٌ","wc":6},{"id":69013,"a":13,"c":29,"p":566,"t":"فَاِذَا نُفِخَ فِي الصُّورِ نَفْخَةٌ وَاحِدَةٌۙ","wc":6},{"id":69014,"a":14,"c":29,"p":566,"t":"وَحُمِلَتِ الْاَرْضُ وَالْجِبَالُ فَدُكَّتَا دَكَّةً وَاحِدَةً","wc":6},{"id":69015,"a":15,"c":29,"p":566,"t":"فَيَوْمَئِذٍ وَقَعَتِ الْوَاقِعَةُۙ","wc":3},{"id":69016,"a":16,"c":29,"p":566,"t":"وَانْشَقَّتِ السَّمَٓاءُ فَهِيَ يَوْمَئِذٍ وَاهِيَةٌۙ","wc":5},{"id":69017,"a":17,"c":29,"p":566,"t":"وَالْمَلَكُ عَلٰٓى اَرْجَٓائِهَاۜ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍ ثَمَانِيَةٌۜ","wc":9},{"id":69018,"a":18,"c":29,"p":566,"t":"يَوْمَئِذٍ تُعْرَضُونَ لَا تَخْفٰى مِنْكُمْ خَافِيَةٌ","wc":6},{"id":69019,"a":19,"c":29,"p":566,"t":"فَاَمَّا مَنْ اُو۫تِيَ كِتَابَهُ بِيَم۪ينِه۪ فَيَقُولُ هَٓاؤُ۬مُ اقْرَؤُ۫ا كِتَابِيَهْۚ","wc":9},{"id":69020,"a":20,"c":29,"p":566,"t":"اِنّ۪ي ظَنَنْتُ اَنّ۪ي مُلَاقٍ حِسَابِيَهْۚ","wc":5},{"id":69021,"a":21,"c":29,"p":566,"t":"فَهُوَ ف۪ي ع۪يشَةٍ رَاضِيَةٍۙ","wc":4,"dup":1,"dupX":1},{"id":69022,"a":22,"c":29,"p":566,"t":"ف۪ي جَنَّةٍ عَالِيَةٍۙ","wc":3,"dup":1,"dupX":1},{"id":69023,"a":23,"c":29,"p":566,"t":"قُطُوفُهَا دَانِيَةٌ","wc":2},{"id":69024,"a":24,"c":29,"p":566,"t":"كُلُوا وَاشْرَبُوا هَن۪ٓيـًٔا بِمَٓا اَسْلَفْتُمْ فِي الْاَيَّامِ الْخَالِيَةِ","wc":8},{"id":69025,"a":25,"c":29,"p":566,"t":"وَاَمَّا مَنْ اُو۫تِيَ كِتَابَهُ بِشِمَالِه۪ فَيَقُولُ يَا لَيْتَن۪ي لَمْ اُو۫تَ كِتَابِيَهْۚ","wc":10},{"id":69026,"a":26,"c":29,"p":566,"t":"وَلَمْ اَدْرِ مَا حِسَابِيَهْۚ","wc":4},{"id":69027,"a":27,"c":29,"p":566,"t":"يَا لَيْتَهَا كَانَتِ الْقَاضِيَةَۚ","wc":3},{"id":69028,"a":28,"c":29,"p":566,"t":"مَٓا اَغْنٰى عَنّ۪ي مَالِيَهْۚ","wc":4},{"id":69029,"a":29,"c":29,"p":566,"t":"هَلَكَ عَنّ۪ي سُلْطَانِيَهْۚ","wc":3},{"id":69030,"a":30,"c":29,"p":566,"t":"خُذُوهُ فَغُلُّوهُۙ","wc":2},{"id":69031,"a":31,"c":29,"p":566,"t":"ثُمَّ الْجَح۪يمَ صَلُّوهُۙ","wc":3},{"id":69032,"a":32,"c":29,"p":566,"t":"ثُمَّ ف۪ي سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعًا فَاسْلُكُوهُۜ","wc":7},{"id":69033,"a":33,"c":29,"p":566,"t":"اِنَّهُ كَانَ لَا يُؤْمِنُ بِاللّٰهِ الْعَظ۪يمِۙ","wc":6},{"id":69034,"a":34,"c":29,"p":566,"t":"وَلَا يَحُضُّ عَلٰى طَعَامِ الْمِسْك۪ينِۜ","wc":5,"dup":1,"dupX":1},{"id":69035,"a":35,"c":29,"p":567,"t":"فَلَيْسَ لَهُ الْيَوْمَ هٰهُنَا حَم۪يمٌۙ","wc":5},{"id":69036,"a":36,"c":29,"p":567,"t":"وَلَا طَعَامٌ اِلَّا مِنْ غِسْل۪ينٍۙ","wc":5},{"id":69037,"a":37,"c":29,"p":567,"t":"لَا يَأْكُلُهُٓ اِلَّا الْخَاطِؤُ۫نَ۟","wc":4},{"id":69038,"a":38,"c":29,"p":567,"t":"فَلَٓا اُقْسِمُ بِمَا تُبْصِرُونَۙ","wc":4},{"id":69039,"a":39,"c":29,"p":567,"t":"وَمَا لَا تُبْصِرُونَۙ","wc":3},{"id":69040,"a":40,"c":29,"p":567,"t":"اِنَّهُ لَقَوْلُ رَسُولٍ كَر۪يمٍۚ","wc":4,"dup":1,"dupX":1},{"id":69041,"a":41,"c":29,"p":567,"t":"وَمَا هُوَ بِقَوْلِ شَاعِرٍۜ قَل۪يلًا مَا تُؤْمِنُونَۙ","wc":7},{"id":69042,"a":42,"c":29,"p":567,"t":"وَلَا بِقَوْلِ كَاهِنٍۜ قَل۪يلًا مَا تَذَكَّرُونَۜ","wc":6},{"id":69043,"a":43,"c":29,"p":567,"t":"تَنْز۪يلٌ مِنْ رَبِّ الْعَالَم۪ينَ","wc":4,"dup":1,"dupX":1},{"id":69044,"a":44,"c":29,"p":567,"t":"وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ الْاَقَاو۪يلِۙ","wc":5},{"id":69045,"a":45,"c":29,"p":567,"t":"لَاَخَذْنَا مِنْهُ بِالْيَم۪ينِۙ","wc":3},{"id":69046,"a":46,"c":29,"p":567,"t":"ثُمَّ لَقَطَعْنَا مِنْهُ الْوَت۪ينَۘ","wc":4},{"id":69047,"a":47,"c":29,"p":567,"t":"فَمَا مِنْكُمْ مِنْ اَحَدٍ عَنْهُ حَاجِز۪ينَ","wc":6},{"id":69048,"a":48,"c":29,"p":567,"t":"وَاِنَّهُ لَتَذْكِرَةٌ لِلْمُتَّق۪ينَ","wc":3},{"id":69049,"a":49,"c":29,"p":567,"t":"وَاِنَّا لَنَعْلَمُ اَنَّ مِنْكُمْ مُكَذِّب۪ينَ","wc":5},{"id":69050,"a":50,"c":29,"p":567,"t":"وَاِنَّهُ لَحَسْرَةٌ عَلَى الْكَافِر۪ينَ","wc":4},{"id":69051,"a":51,"c":29,"p":567,"t":"وَاِنَّهُ لَحَقُّ الْيَق۪ينِ","wc":3},{"id":69052,"a":52,"c":29,"p":567,"t":"فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظ۪يمِ","wc":4,"dup":1,"dupX":1}]}