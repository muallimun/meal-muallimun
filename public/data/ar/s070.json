{"s":70,"verses":[{"id":70001,"a":1,"c":29,"p":567,"t":"سَاَلَ سَٓائِلٌ بِعَذَابٍ وَاقِعٍۙ","wc":4},{"id":70002,"a":2,"c":29,"p":567,"t":"لِلْكَافِر۪ينَ لَيْسَ لَهُ دَافِعٌۙ","wc":4},{"id":70003,"a":3,"c":29,"p":567,"t":"مِنَ اللّٰهِ ذِي الْمَعَارِجِۜ","wc":4},{"id":70004,"a":4,"c":29,"p":567,"t":"تَعْرُجُ الْمَلٰٓئِكَةُ وَالرُّوحُ اِلَيْهِ ف۪ي يَوْمٍ كَانَ مِقْدَارُهُ خَمْس۪ينَ اَلْفَ سَنَةٍۚ","wc":11},{"id":70005,"a":5,"c":29,"p":567,"t":"فَاصْبِرْ صَبْرًا جَم۪يلًا","wc":3},{"id":70006,"a":6,"c":29,"p":567,"t":"اِنَّهُمْ يَرَوْنَهُ بَع۪يدًاۙ","wc":3},{"id":70007,"a":7,"c":29,"p":567,"t":"وَنَرٰيهُ قَر۪يبًاۜ","wc":2},{"id":70008,"a":8,"c":29,"p":567,"t":"يَوْمَ تَكُونُ السَّمَٓاءُ كَالْمُهْلِۙ","wc":4},{"id":70009,"a":9,"c":29,"p":567,"t":"وَتَكُونُ الْجِبَالُ كَالْعِهْنِۙ","wc":3},{"id":70010,"a":10,"c":29,"p":567,"t":"وَلَا يَسْـَٔلُ حَم۪يمٌ حَم۪يمًاۚ","wc":4},{"id":70011,"a":11,"c":29,"p":568,"t":"يُبَصَّرُونَهُمْۜ يَوَدُّ الْمُجْرِمُ لَوْ يَفْتَد۪ي مِنْ عَذَابِ يَوْمِئِذٍ بِبَن۪يهِۙ","wc":9},{"id":70012,"a":12,"c":29,"p":568,"t":"وَصَاحِبَتِه۪ وَاَخ۪يهِۙ","wc":2},{"id":70013,"a":13,"c":29,"p":568,"t":"وَفَص۪يلَتِهِ الَّت۪ي تُـْٔو۪يهِۙ","wc":3},{"id":70014,"a":14,"c":29,"p":568,"t":"وَمَنْ فِي الْاَرْضِ جَم۪يعًاۙ ثُمَّ يُنْج۪يهِۙ","wc":6},{"id":70015,"a":15,"c":29,"p":568,"t":"كَلَّاۜ اِنَّهَا لَظٰىۙ","wc":3},{"id":70016,"a":16,"c":29,"p":568,"t":"نَزَّاعَةً لِلشَّوٰىۚ","wc":2},{"id":70017,"a":17,"c":29,"p":568,"t":"تَدْعُوا مَنْ اَدْبَرَ وَتَوَلّٰىۙ","wc":4},{"id":70018,"a":18,"c":29,"p":568,"t":"وَجَمَعَ فَاَوْعٰى","wc":2},{"id":70019,"a":19,"c":29,"p":568,"t":"اِنَّ الْاِنْسَانَ خُلِقَ هَلُوعًاۙ","wc":4},{"id":70020,"a":20,"c":29,"p":568,"t":"اِذَا مَسَّهُ الشَّرُّ جَزُوعًاۙ","wc":4},{"id":70021,"a":21,"c":29,"p":568,"t":"وَاِذَا مَسَّهُ الْخَيْرُ مَنُوعًاۙ","wc":4},{"id":70022,"a":22,"c":29,"p":568,"t":"اِلَّا الْمُصَلّ۪ينَۙ","wc":2},{"id":70023,"a":23,"c":29,"p":568,"t":"اَلَّذ۪ينَ هُمْ عَلٰى صَلَاتِهِمْ دَٓائِمُونَۖ","wc":5},{"id":70024,"a":24,"c":29,"p":568,"t":"وَالَّذ۪ينَ ف۪ٓي اَمْوَالِهِمْ حَقٌّ مَعْلُومٌۙ","wc":5},{"id":70025,"a":25,"c":29,"p":568,"t":"لِلسَّٓائِلِ وَالْمَحْرُومِۖ","wc":2},{"id":70026,"a":26,"c":29,"p":568,"t":"وَالَّذ۪ينَ يُصَدِّقُونَ بِيَوْمِ الدّ۪ينِۖ","wc":4},{"id":70027,"a":27,"c":29,"p":568,"t":"وَالَّذ۪ينَ هُمْ مِنْ عَذَابِ رَبِّهِمْ مُشْفِقُونَۚ","wc":6},{"id":70028,"a":28,"c":29,"p":568,"t":"اِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍۚ","wc":5},{"id":70029,"a":29,"c":29,"p":568,"t":"وَالَّذ۪ينَ هُمْ لِفُرُوجِهِمْ حَافِظُونَۙ","wc":4,"dup":1,"dupX":1},{"id":70030,"a":30,"c":29,"p":568,"t":"اِلَّا عَلٰٓى اَزْوَاجِهِمْ اَوْ مَا مَلَكَتْ اَيْمَانُهُمْ فَاِنَّهُمْ غَيْرُ مَلُوم۪ينَۚ","wc":10,"dup":1,"dupX":1},{"id":70031,"a":31,"c":29,"p":568,"t":"فَمَنِ ابْتَغٰى وَرَٓاءَ ذٰلِكَ فَاُو۬لٰٓئِكَ هُمُ الْعَادُونَۚ","wc":7,"dup":1,"dupX":1},{"id":70032,"a":32,"c":29,"p":568,"t":"وَالَّذ۪ينَ هُمْ لِاَمَانَاتِهِمْ وَعَهْدِهِمْ رَاعُونَۖ","wc":5,"dup":1,"dupX":1},{"id":70033,"a":33,"c":29,"p":568,"t":"وَالَّذ۪ينَ هُمْ بِشَهَادَاتِهِمْ قَٓائِمُونَۖ","wc":4},{"id":70034,"a":34,"c":29,"p":568,"t":"وَالَّذ۪ينَ هُمْ عَلٰى صَلَاتِهِمْ يُحَافِظُونَۜ","wc":5},{"id":70035,"a":35,"c":29,"p":568,"t":"اُو۬لٰٓئِكَ ف۪ي جَنَّاتٍ مُكْرَمُونَۜ۟","wc":4},{"id":70036,"a":36,"c":29,"p":568,"t":"فَمَالِ ‌الَّذ۪ينَ كَفَرُوا قِبَلَكَ مُهْطِع۪ينَۙ","wc":5},{"id":70037,"a":37,"c":29,"p":568,"t":"عَنِ الْيَم۪ينِۙ وَعَنِ الشِّمَالِ عِز۪ينَ","wc":5},{"id":70038,"a":38,"c":29,"p":568,"t":"اَيَطْمَعُ كُلُّ امْرِئٍ مِنْهُمْ اَنْ يُدْخَلَ جَنَّةَ نَع۪يمٍۙ","wc":8},{"id":70039,"a":39,"c":29,"p":568,"t":"كَلَّاۜ اِنَّا خَلَقْنَاهُمْ مِمَّا يَعْلَمُونَ","wc":5},{"id":70040,"a":40,"c":29,"p":569,"t":"فَلَٓا اُقْسِمُ بِرَبِّ الْمَشَارِقِ وَالْمَغَارِبِ اِنَّا لَقَادِرُونَۙ","wc":7},{"id":70041,"a":41,"c":29,"p":569,"t":"عَلٰٓى اَنْ نُبَدِّلَ خَيْرًا مِنْهُمْۙ وَمَا نَحْنُ بِمَسْبُوق۪ينَ","wc":8},{"id":70042,"a":42,"c":29,"p":569,"t":"فَذَرْهُمْ يَخُوضُوا وَيَلْعَبُوا حَتّٰى يُلَاقُوا يَوْمَهُمُ الَّذ۪ي يُوعَدُونَۙ","wc":8,"dup":1,"dupX":1},{"id":70043,"a":43,"c":29,"p":569,"t":"يَوْمَ يَخْرُجُونَ مِنَ الْاَجْدَاثِ سِرَاعًا كَاَنَّهُمْ اِلٰى نُصُبٍ يُوفِضُونَۙ","wc":9},{"id":70044,"a":44,"c":29,"p":569,"t":"خَاشِعَةً اَبْصَارُهُمْ تَرْهَقُهُمْ ذِلَّةٌۜ ذٰلِكَ الْيَوْمُ الَّذ۪ي كَانُوا يُوعَدُونَ","wc":9}]}