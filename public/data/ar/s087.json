{"s":87,"verses":[{"id":87001,"a":1,"c":30,"p":591,"t":"سَبِّحِ اسْمَ رَبِّكَ الْاَعْلٰىۙ","wc":4},{"id":87002,"a":2,"c":30,"p":591,"t":"اَلَّذ۪ي خَلَقَ فَسَوّٰىۙۖ","wc":3},{"id":87003,"a":3,"c":30,"p":591,"t":"وَالَّذ۪ي قَدَّرَ فَهَدٰىۙۖ","wc":3},{"id":87004,"a":4,"c":30,"p":591,"t":"وَالَّذ۪ٓي اَخْرَجَ الْمَرْعٰىۙۖ","wc":3},{"id":87005,"a":5,"c":30,"p":591,"t":"فَجَعَلَهُ غُثَٓاءً اَحْوٰىۜ","wc":3},{"id":87006,"a":6,"c":30,"p":591,"t":"سَنُقْرِئُكَ فَلَا تَنْسٰىۙ","wc":3},{"id":87007,"a":7,"c":30,"p":591,"t":"اِلَّا مَا شَٓاءَ اللّٰهُۜ اِنَّهُ يَعْلَمُ الْجَهْرَ وَمَا يَخْفٰىۜ","wc":9},{"id":87008,"a":8,"c":30,"p":591,"t":"وَنُيَسِّرُكَ لِلْيُسْرٰىۚ","wc":2},{"id":87009,"a":9,"c":30,"p":591,"t":"فَذَكِّرْ اِنْ نَفَعَتِ الذِّكْرٰىۜ","wc":4},{"id":87010,"a":10,"c":30,"p":591,"t":"سَيَذَّكَّرُ مَنْ يَخْشٰىۙ","wc":3},{"id":87011,"a":11,"c":30,"p":591,"t":"وَيَتَجَنَّبُهَا الْاَشْقٰىۙ","wc":2},{"id":87012,"a":12,"c":30,"p":591,"t":"اَلَّذ۪ي يَصْلَى النَّارَ الْكُبْرٰىۚ","wc":4},{"id":87013,"a":13,"c":30,"p":591,"t":"ثُمَّ لَا يَمُوتُ ف۪يهَا وَلَا يَحْيٰىۜ","wc":6},{"id":87014,"a":14,"c":30,"p":591,"t":"قَدْ اَفْلَحَ مَنْ تَزَكّٰىۙ","wc":4},{"id":87015,"a":15,"c":30,"p":591,"t":"وَذَكَرَ اسْمَ رَبِّه۪ فَصَلّٰىۜ","wc":4},{"id":87016,"a":16,"c":30,"p":591,"t":"بَلْ تُؤْثِرُونَ الْحَيٰوةَ الدُّنْيَاۘ","wc":4},{"id":87017,"a":17,"c":30,"p":591,"t":"وَالْاٰخِرَةُ خَيْرٌ وَاَبْقٰىۜ","wc":3},{"id":87018,"a":18,"c":30,"p":591,"t":"اِنَّ هٰذَا لَفِي الصُّحُفِ الْاُو۫لٰىۙ","wc":5},{"id":87019,"a":19,"c":30,"p":591,"t":"صُحُفِ اِبْرٰه۪يمَ وَمُوسٰى","wc":3}]}