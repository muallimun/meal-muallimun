{"s":1,"verses":[{"id":1001,"a":1,"c":1,"p":1,"t":"بِسْمِ اللَّهِ اَلرَّحْمٰنِ الرَّحِيمِ","wc":4},{"id":1002,"a":2,"c":1,"p":1,"t":"اَلْحَمْدُ لِلّٰهِ رَبِّ الْعَالَم۪ينَۙ","wc":4},{"id":1003,"a":3,"c":1,"p":1,"t":"اَلرَّحْمٰنِ الرَّح۪يمِۙ","wc":2},{"id":1004,"a":4,"c":1,"p":1,"t":"مَالِكِ يَوْمِ الدّ۪ينِۜ","wc":3},{"id":1005,"a":5,"c":1,"p":1,"t":"اِيَّاكَ نَعْبُدُ وَاِيَّاكَ نَسْتَع۪ينُۜ","wc":4},{"id":1006,"a":6,"c":1,"p":1,"t":"اِهْدِنَا الصِّرَاطَ الْمُسْتَق۪يمَۙ","wc":3},{"id":1007,"a":7,"c":1,"p":1,"t":"صِرَاطَ الَّذ۪ينَ اَنْعَمْتَ عَلَيْهِمْۙ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّٓالّ۪ينَ","wc":9}]}