{"s":97,"verses":[{"id":97001,"a":1,"c":30,"p":598,"t":"اِنَّٓا اَنْزَلْنَاهُ ف۪ي لَيْلَةِ الْقَدْرِۚ","wc":5},{"id":97002,"a":2,"c":30,"p":598,"t":"وَمَٓا اَدْرٰيكَ مَا لَيْلَةُ الْقَدْرِۜ","wc":5},{"id":97003,"a":3,"c":30,"p":598,"t":"لَيْلَةُ الْقَدْرِ خَيْرٌ مِنْ اَلْفِ شَهْرٍۜ","wc":6},{"id":97004,"a":4,"c":30,"p":598,"t":"تَنَزَّلُ الْمَلٰٓئِكَةُ وَالرُّوحُ ف۪يهَا بِاِذْنِ رَبِّهِمْۚ مِنْ كُلِّ اَمْرٍۙۛ","wc":9},{"id":97005,"a":5,"c":30,"p":598,"t":"سَلَامٌ۠ۛ هِيَ حَتّٰى مَطْلَعِ الْفَجْرِ","wc":5}]}